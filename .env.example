# Jurimetria DPT — De Paula Teixeira Advocacia
# Copie para .env e ajuste conforme o ambiente

# Banco SQLite (Prisma) — base geral de conhecimento jurídico
DATABASE_URL=file:./db/custom.db

# API Pública DataJud/CNJ — jurimetria e consulta processual em tempo real
# Chave pública gratuita — obtenha a sua em https://datajud-wiki.cnj.jus.br/api-publica/
# (a chave pública de demonstração é publicada abertamente pela wiki oficial do CNJ)
DATAJUD_API_KEY=

# Token GitHub para publicação (scripts/publish-github.sh). NUNCA versione o valor real.
GITHUB_TOKEN=
