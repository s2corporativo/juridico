{
  "name": "atlas-juridico",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:atlas": "cd apps/atlas-forense && pnpm dev",
    "dev:juridia": "cd apps/juridia && bun run dev",
    "dev": "concurrently \"pnpm dev:atlas\" \"pnpm dev:juridia\"",
    "build:atlas": "cd apps/atlas-forense && pnpm build",
    "build:juridia": "cd apps/juridia && bun run build",
    "check:atlas": "cd apps/atlas-forense && pnpm check",
    "check:juridia": "cd apps/juridia && bun x tsc --noEmit",
    "test:atlas": "cd apps/atlas-forense && pnpm test",
    "test:juridia": "cd apps/juridia && bun test",
    "map:architecture": "./scripts/architecture-map.sh",
    "gate:release": "bash scripts/release-gate.sh"
  },
  "devDependencies": {
    "concurrently": "^9.0.0"
  }
}
