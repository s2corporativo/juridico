# Caddy staging — aplicar somente após Next com basePath=/juridia homologado.
# Não usar handle_path: removeria o prefixo de que o Next depende.
{
  admin off
}

:8443 {
  bind 127.0.0.1
  encode zstd gzip
  @juridia path /juridia /juridia/*
  handle @juridia {
    reverse_proxy 127.0.0.1:3005 {
      # TLS foi encerrado pelo Nginx localhost.
      header_up X-Forwarded-Proto https
    }
  }
  handle /socket.io/* {
    reverse_proxy 127.0.0.1:3003 {
      # TLS foi encerrado pelo Nginx localhost.
      header_up X-Forwarded-Proto https
    }
  }
  handle {
    reverse_proxy 127.0.0.1:3114 {
      # TLS foi encerrado pelo Nginx localhost.
      header_up X-Forwarded-Proto https
    }
  }
}
