[Unit]
Description=Atlas Forense, coleta publica editorial diaria STJ e DJEN
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=atlas
Group=atlas
EnvironmentFile=/etc/atlas-ejc/atlas.env
ExecStart=/usr/bin/bash /opt/atlas-ejc/current/apps/atlas-forense/deploy/run-editorial-daily.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
