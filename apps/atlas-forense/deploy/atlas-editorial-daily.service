[Unit]
Description=Atlas Juridico — atualizacao juridica diaria oficial
Wants=network-online.target
After=network-online.target atlas-juridico.service
ConditionPathExists=/opt/atlas-juridico/shared/bin/run-editorial-daily.sh
ConditionPathExists=/etc/atlas-juridico/editorial.env

[Service]
Type=oneshot
User=sentinelx
Group=sentinelx
EnvironmentFile=/etc/atlas-juridico/editorial.env
ExecStart=/usr/bin/bash /opt/atlas-juridico/shared/bin/run-editorial-daily.sh
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/atlas-juridico/shared/bin
# This trigger is strictly read-only; database writes happen inside the Atlas service.
PrivateDevices=true

[Install]
WantedBy=multi-user.target
