NODE_ENV=production
PORT=3010
DATABASE_URL=mysql://atlas_app:SUBSTITUIR_POR_SEGREDO@127.0.0.1:3306/atlas_ejc
JWT_SECRET=GERAR_SEGREDO_ALEATORIO_DE_64_CARACTERES_OU_MAIS
# Serviço de notificação (WebSocket) — porta fixa, somente loopback; rota externa /socket.io/.
NOTIFICATION_SERVICE_PORT=3003
NOTIFICATION_INTERNAL_SECRET=GERAR_COM_openssl_rand_hex_32
# Origens exatas autorizadas no WebSocket (CORS restrito, sem wildcard).
ATLAS_ALLOWED_ORIGINS=https://atlas.depaulateixeira.adv.br
# OAuth/Manus permanece desabilitado na VPS até configuração de redirect URI e SSO do EJC.
# EJC/SSO (ver docs/ejc-sso-ativacao.md — nunca versionar valores reais):
# EJC_SSO_ENABLED=true
# EJC_OIDC_ISSUER=https://sso.<dominio-do-ejc>/api/auth/oidc
# EJC_OIDC_CLIENT_ID=atlas-forense
# EJC_OIDC_CLIENT_SECRET=
# EJC_SSO_REDIRECT_URI=https://atlas.depaulateixeira.adv.br/api/ejc-sso/callback  # opcional (deriva do Host)
