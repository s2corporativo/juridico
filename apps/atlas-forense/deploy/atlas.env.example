# Atlas Forense — env de produção (VPS)
# Definitivo: ver docs/segredos-producao-vps.md · gerado/executado por deploy/render-env.sh
# NUNCA versionar valores reais. Permissão alvo do arquivo real: 0640 root:atlas.
NODE_ENV=production
PORT=3010
DATABASE_URL=mysql://atlas_app:SUBSTITUIR_POR_SENHA_FORTE_DO_MARIADB@127.0.0.1:3306/atlas_ejc
JWT_SECRET=GERADO_PELO_RENDER_ENV_openssl_rand_hex_32
SESSION_SECRET=GERADO_PELO_RENDER_ENV_openssl_rand_hex_32
# Serviço de notificação (WebSocket) — porta fixa, somente loopback; rota externa /socket.io/.
NOTIFICATION_SERVICE_PORT=3003
NOTIFICATION_INTERNAL_SECRET=GERADO_PELO_RENDER_ENV_openssl_rand_hex_32
# Origens exatas autorizadas no WebSocket (CORS restrito, sem wildcard).
ATLAS_ALLOWED_ORIGINS=https://atlas.depaulateixeira.adv.br
# Credencial pública do DataJud/CNJ (fornecida pelo operador; habilita o conector).
# DATAJUD_API_KEY=
# EJC/SSO — ponte Atlas⇄JuridIA (docs/ejc-sso-ativacao.md · docs/segredos-producao-vps.md):
EJC_SSO_ENABLED=true
EJC_OIDC_ISSUER=https://sso.<dominio-do-ejc>/api/auth/oidc
EJC_OIDC_CLIENT_ID=atlas-forense
EJC_OIDC_CLIENT_SECRET=GERADO_PELO_RENDER_ENV_MESMO_VALOR_NO_JURIDIA
# EJC_SSO_REDIRECT_URI=https://atlas.depaulateixeira.adv.br/api/ejc-sso/callback  # opcional (deriva do Host)
# OAuth/Manus permanece desabilitado na VPS (OAUTH_SERVER_URL/OWNER_OPEN_ID/VITE_APP_ID ausentes).
