# Prisma SQLite database URL
# Substitua o caminho pelo local do seu projeto
DATABASE_URL="file:/home/seu-usuario/juridia/db/custom.db"

# Em produção, configure estes para segurança:
# NODE_ENV=production
# JURIDIA_API_TOKEN=sua-token-secreta-aqui

# Política de IA: processamento externo de casos sempre desligado por padrão.
# JURIDIA_LOCAL_AI_ENABLED=false
# JURIDIA_LOCAL_AI_MODEL=qwen3:4b-instruct
# JURIDIA_EXTERNAL_AI_ENABLED=false
# JURIDIA_CONFIDENTIAL_DATA_EXPORT_APPROVED=false

# Cofre de documentos originais (padrão DESATIVADO).
# Configurar apenas após backup cifrado e restauração testada.
# O diretório precisa estar FORA da aplicação, com acesso 0700 pelo usuário do serviço.
# JURIDIA_PRIVATE_UPLOAD_ROOT=/srv/private/juridia-originals
# A chave deve ter 64 caracteres hexadecimais aleatórios (32 bytes).
# Armazenar em cofre de segredos, NUNCA no repositório ou no frontend.
# JURIDIA_PRIVATE_UPLOAD_KEY=COLOQUE_NO_COFRE_DE_SEGREDOS_NAO_AQUI

# Para análise somente leitura e verificação de fontes do corpus SQLite:
# JURIDIA_KNOWLEDGE_DB_PATH=/absolute/private/juridia.db
