# Prisma SQLite database URL
# Substitua o caminho pelo local do seu projeto
DATABASE_URL="file:/home/seu-usuario/juridia/db/custom.db"

# Em produção, configure estes para segurança:
# NODE_ENV=production
# JURIDIA_API_TOKEN=sua-token-secreta-aqui

# Token de acesso à API DataJud CNJ (obrigatório para consulta jurisprudencial)
# Gere seu token em: https://api-publica.datajud.cnj.jus.br/
DATAJUD_TOKEN=
