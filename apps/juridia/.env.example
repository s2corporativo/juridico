# Prisma SQLite database URL
# Substitua o caminho pelo local do seu projeto
DATABASE_URL="file:/home/seu-usuario/juridia/db/custom.db"

# Em produção, configure estes para segurança:
# NODE_ENV=production
# JURIDIA_API_TOKEN=sua-token-secreta-aqui


# EJC Brain / AI Gateway
# AI_ENABLED=true
# AI_EXTERNAL_PROVIDERS_ALLOWED=true
# ZAI_ENABLED=true
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:14b
# GROQ_ENABLED=true
# GROQ_BASE_URL=https://SEU-ENDPOINT-COMPATIVEL/v1
# GROQ_API_KEY=
# GROQ_MODEL=
# MARITACA_ENABLED=true
# MARITACA_BASE_URL=https://SEU-ENDPOINT-COMPATIVEL/v1
# MARITACA_API_KEY=
# MARITACA_MODEL=

# Embeddings jurídicos locais (BM25 + embedding + RRF)
# EMBEDDINGS_ENABLED=true
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Importação do acervo EJC/Atlas existente na mesma VPS
# ATLAS_KNOWLEDGE_DB_PATH=/opt/atlas-juridico/shared/custom.db
