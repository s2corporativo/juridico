  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "build": "next build && mkdir -p .next/standalone/apps/juridia/.next/static .next/standalone/apps/juridia/public && cp -a .next/static/. .next/standalone/apps/juridia/.next/static/ && cp -a public/. .next/standalone/apps/juridia/public/",
