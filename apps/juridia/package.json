    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "maturity:audit": "bun run scripts/audit-legal-maturation.ts",
    "curation:import-drafts": "bun run scripts/import-curation-starter.ts"
  },
