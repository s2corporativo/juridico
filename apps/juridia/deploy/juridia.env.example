# JuridIA (EJC) — env de produção (VPS)
# Definitivo: ver apps/atlas-forense/docs/segredos-producao-vps.md
# NUNCA versionar valores reais. Permissão alvo do arquivo real: 0640 root:juridia.
# Porta fixa 3005 — contrato operacional do bot: apps/juridia/docs/contrato-operacional-bot.md
NODE_ENV=production
PORT=3005
DATABASE_URL=file:/opt/juridia/data/juridia.db
# Sessão local (scrypt + cookie HMAC) — sem ela, login e rotas protegidas ficam 503 (fail-closed).
JURIDIA_SESSION_SECRET=GERADO_PELO_RENDER_ENV_openssl_rand_hex_32
# IdP OIDC do EJC (provider do SSO do Atlas) — issuer IDÊNTICO ao EJC_OIDC_ISSUER do Atlas.
JURIDIA_OIDC_ISSUER=https://sso.<dominio-do-ejc>/api/auth/oidc
EJC_OIDC_CLIENT_ID=atlas-forense
EJC_OIDC_CLIENT_SECRET=GERADO_PELO_RENDER_ENV_MESMO_VALOR_NO_ATLAS
# Allowlist EXATA de redirect_uri do cliente SSO.
EJC_OIDC_REDIRECT_URIS=https://atlas.depaulateixeira.adv.br/api/ejc-sso/callback
# PROIBIDO em produção: EJC_SSO_DEV_ALLOW_LOCAL (o --check sinaliza; o código recusa em prod).
# Opcional, apenas para o seed one-time do administrador (remover depois de rodar):
# EJC_ADMIN_EMAIL=advogado@escritorio.adv.br
# EJC_ADMIN_PASSWORD=
# EJC_ADMIN_NAME=
