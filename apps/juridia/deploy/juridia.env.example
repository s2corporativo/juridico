# Atlas Jurídico — motor JuridIA
NODE_ENV=production
PORT=3005
DATABASE_URL=file:/opt/juridia/data/juridia.db
JURIDIA_SESSION_SECRET=GERAR_COM_32_BYTES_OU_MAIS

JURIDIA_OIDC_ISSUER=https://juridia.depaulateixeira.adv.br/api/auth/oidc
ATLAS_OIDC_CLIENT_ID=atlas-juridico
ATLAS_OIDC_CLIENT_SECRET=USAR_O_MESMO_VALOR_NO_ATLAS
ATLAS_OIDC_REDIRECT_URIS=https://atlas.depaulateixeira.adv.br/api/sso/callback

# Somente desenvolvimento local:
# JURIDIA_OIDC_DEV_ALLOW_LOCAL=1

# Seed administrativo one-time:
# JURIDIA_ADMIN_EMAIL=
# JURIDIA_ADMIN_PASSWORD=
# JURIDIA_ADMIN_NAME=
