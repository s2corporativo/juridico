# Exemplo SEM credenciais. Manter o arquivo real fora do Git, permissao 0600.
NODE_ENV=production
ATLAS_API_URL=http://127.0.0.1:3114
ATLAS_BRAIN_API_TOKEN=SUBSTITUIR_POR_CHAVE_DISTINTA_COM_32_CARACTERES_OU_MAIS
JURIDIA_KNOWLEDGE_DB_PATH=/opt/atlas-juridia/shared/juridia.db
# Arquivo de atestacao atualizado EXCLUSIVAMENTE apos backup restauravel verificado.
JURIDIA_SYNC_VERIFIED_BACKUP=/opt/atlas-juridia/shared/backup-verified.marker
