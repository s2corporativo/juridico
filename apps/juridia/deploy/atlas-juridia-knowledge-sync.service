[Unit]
Description=Atlas Forense → JuridIA: sincronizacao segura de metadados editoriais
After=network-online.target
Wants=network-online.target
# Instalar apenas após release com backup/restauracao e teste do token.

[Service]
Type=oneshot
User=juridia
Group=juridia
WorkingDirectory=/opt/atlas-juridia/current/apps/juridia
Environment=NODE_ENV=production
Environment=TZ=America/Sao_Paulo
EnvironmentFile=/etc/juridia/atlas-knowledge.env
ExecStart=/usr/local/bin/bun scripts/sync-atlas-knowledge.ts
TimeoutStartSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/atlas-juridia/shared
UMask=0077
