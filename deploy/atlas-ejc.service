[Unit]
Description=Atlas Forense EJC
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
Type=simple
User=atlas
Group=atlas
WorkingDirectory=/opt/atlas-ejc/current
EnvironmentFile=/etc/atlas-ejc/atlas.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/atlas-ejc

[Install]
WantedBy=multi-user.target
